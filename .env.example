# Supabase Configuration
# Get these from your Supabase project at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics
# Google Analytics - Get from https://analytics.google.com
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry Error Tracking - Get from https://sentry.io
VITE_SENTRY_DSN=https://key@sentry.io/project-id
